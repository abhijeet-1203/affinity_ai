      "type": "INTEGER",
      "default": 99
    },
    {
      "name": "w_shared",
      "type": "FLOAT",
      "default": 0.35
    },
    {
      "name": "w_semantic",
      "type": "FLOAT",
      "default": 0.25
    },
    {
      "name": "w_communication",
      "type": "FLOAT",
      "default": 0.2
    },
    {
      "name": "w_lifestyle",
      "type": "FLOAT",
      "default": 0.2
    },
    {
      "name": "include_demo",
      "type": "BOOLEAN",
      "default": true
    }
  ],
  "config": {}
}
